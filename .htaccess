# ----------------------------------------------------------------------
# 1. SICHERHEIT: Zugriff auf sensible Dateien sperren
# ----------------------------------------------------------------------

# Sperre den Zugriff auf alle .env Dateien (Apache 2.2 und 2.4 kompatibel)
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Sperre den Zugriff auf Git-Konfigurationen und Assistant-Daten
RedirectMatch 404 /\.git
RedirectMatch 404 /\.agents
RedirectMatch 404 /\.gemini
RedirectMatch 404 /brain

# Verhindert das Auflisten von Ordnerinhalten (Directory Browsing)
Options -Indexes

# ----------------------------------------------------------------------
# 2. DATEI-SCHUTZ: Direkten Zugriff auf Daten einschränken
# ----------------------------------------------------------------------

# Schützt interne .json Dateien, erlaubt aber manifest.json und sender_daten.json
<Files "*.json">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

<FilesMatch "^(manifest|sender_daten)\.json$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Allow from all
    </IfModule>
</FilesMatch>

# ----------------------------------------------------------------------
# 3. WEITERLEITUNG & VERZEICHNIS-INDEX
# ----------------------------------------------------------------------
# index.php hat im Root Vorrang, index.html im frontend/ Ordner
DirectoryIndex index.php index.html